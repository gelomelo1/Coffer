# Copy to .env.development and fill in real values (never commit the real file).
# Same keys as .env plus the development-only settings below.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
COFFER_CONNECTIONSTRING=Host=db;Port=5432;Database=Coffer;Username=postgres;Password=change-me
IMAGESTORE_PATH=/app/data/images
VECTORSTORE_PATH=/app/data/vectors
MODELS_PATH=/app/models
ICONSTORE_PATH=/app/data/icons
IMAGECHECK_TEMP_PATH=/app/data/temp
FASTAPI_URL=http://fastapi:8000
POSTGRES_DB=Coffer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Needed for the mobile GitHub login (server side of the OAuth code exchange).
GITHUB_CLIENT_SECRET=change-me

# ---------------------------------------------------------------------------
# Coffer.Manager (GitHub sign-in). Immutable numeric GitHub user ids, never usernames.
# Find yours: https://api.github.com/users/<your-login>  ->  "id"
# Enable "Device Flow" in the GitHub OAuth app settings (same app as the mobile login).
COFFER_MANAGER_ADMIN_GITHUB_PROVIDER_IDS='["12345678"]'
# Optional: another OAuth app for the Manager (defaults to GITHUB_CLIENT_ID / the built-in app id).
# COFFER_MANAGER_GITHUB_CLIENT_ID=

# ---------------------------------------------------------------------------
# Development seed (Development environment only; the API refuses to start with these on elsewhere).
# DEV_RESET_DATABASE_ON_STARTUP=true empties every user-data table on API start, then seeds again.
DEV_SEED_ENABLED=true
# Sign in to the app as any seeded user without Google/GitHub (Development only; the API refuses to start with it elsewhere).
DEV_LOGIN_ENABLED=true
DEV_RESET_DATABASE_ON_STARTUP=false
# Raw example photos, as seen by the API (docker-compose.dev.yml mounts E:\app\data\examples here).
DEV_SEED_IMAGE_DIR=/app/data/examples
# How long the seed waits for the AI service to come up before importing photos without it.
DEV_SEED_AI_WAIT_SECONDS=180
# The dataset (JSON, single-quoted, no apostrophes inside). Fixed ids; times are offsets from now.
DEV_SEED_DATA_JSON='{
