# Copy to .env and fill in real values (never commit .env). Encrypt into .env.enc with openssl (see the root README).
# Release builds need every value. Debug builds may leave the Google/Facebook/Discord ids out (or as
# placeholders): that sign-in is then off. The backend URL and the scheme are always required.

# The Coffer API. Development: the Android emulator reaches the host's API at 10.0.2.2 (plain HTTP is allowed only
# for 10.0.2.2/localhost/127.0.0.1 in debug builds). Release builds require https://.
EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:5141

# Google Cloud console -> Credentials -> the Web client id (same as GOOGLE_CLIENT_IDS in src/.env).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Facebook app dashboard -> App ID (same as FACEBOOK_APP_ID in src/.env). Placeholder until the Facebook app exists.
EXPO_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# Discord developer portal -> Application ID (same as DISCORD_CLIENT_ID in src/.env). Placeholder until the app exists.
EXPO_PUBLIC_DISCORD_APP_ID=your-discord-application-id

# The app's URL scheme (deep links, GitHub redirect com.gelomelo.coffer://oauth/github).
EXPO_PUBLIC_AUTH_SCHEME=com.gelomelo.coffer
